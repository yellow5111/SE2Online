<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SE2OnlineInstaller.App"
             RequestedThemeVariant="Dark">
  <!-- Space Engineers 2's menu look: deep navy glass panels, square steel-blue controls, amber highlights. -->
  <Application.Resources>
    <SolidColorBrush x:Key="Se2Ink" Color="#E6EEF3" />
    <SolidColorBrush x:Key="Se2Muted" Color="#8EA3B0" />
    <SolidColorBrush x:Key="Se2Panel" Color="#D90A1824" />
    <SolidColorBrush x:Key="Se2Edge" Color="#264559" />
    <SolidColorBrush x:Key="Se2Control" Color="#0E2231" />
    <SolidColorBrush x:Key="Se2ControlEdge" Color="#2E5167" />
    <SolidColorBrush x:Key="Se2Hover" Color="#163449" />
    <SolidColorBrush x:Key="Se2Steel" Color="#9FB4BF" />
    <SolidColorBrush x:Key="Se2Amber" Color="#E58C12" />
    <SolidColorBrush x:Key="Se2Red" Color="#FF5A4D" />
    <SolidColorBrush x:Key="Se2Green" Color="#7FD38A" />
    <CornerRadius x:Key="ControlCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>
    <Color x:Key="SystemAccentColor">#E58C12</Color>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Noto Sans, Segoe UI, Arial" />
      <Setter Property="Foreground" Value="{StaticResource Se2Ink}" />
      <Setter Property="Background" Value="#05090F" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource Se2Panel}" />
      <Setter Property="BorderBrush" Value="{StaticResource Se2Edge}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="26,22" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="46" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBlock.crumb">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="Foreground" Value="{StaticResource Se2Ink}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="21" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Foreground" Value="{StaticResource Se2Muted}" />
    </Style>
    <Style Selector="TextBlock.good">
      <Setter Property="Foreground" Value="{StaticResource Se2Green}" />
    </Style>
    <Style Selector="TextBlock.bad">
      <Setter Property="Foreground" Value="{StaticResource Se2Red}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.badge">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#10151C" />
    </Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="{StaticResource Se2Control}" />
      <Setter Property="BorderBrush" Value="{StaticResource Se2ControlEdge}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource Se2Ink}" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Padding" Value="22,10" />
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Se2Hover}" />
      <Setter Property="BorderBrush" Value="{StaticResource Se2Steel}" />
      <Setter Property="Foreground" Value="{StaticResource Se2Ink}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#0B1A26" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#0A1822" />
      <Setter Property="BorderBrush" Value="#1A3040" />
      <Setter Property="Foreground" Value="#4E6372" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Se2Amber}" />
      <Setter Property="BorderBrush" Value="#F7B04A" />
      <Setter Property="Foreground" Value="#10151C" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F59E28" />
      <Setter Property="BorderBrush" Value="#FFD08A" />
      <Setter Property="Foreground" Value="#10151C" />
    </Style>

    <!-- SE2's Off / On switch: two square segments, the active one lit in steel. -->
    <Style Selector="ToggleButton.segment">
      <Setter Property="Background" Value="{StaticResource Se2Control}" />
      <Setter Property="BorderBrush" Value="{StaticResource Se2ControlEdge}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource Se2Ink}" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="MinWidth" Value="110" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Se2Steel}" />
      <Setter Property="BorderBrush" Value="#C9D8E0" />
      <Setter Property="Foreground" Value="#0A1520" />
    </Style>
    <Style Selector="ToggleButton.segment:pointerover /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource Se2Steel}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="#0B1E2B" />
      <Setter Property="BorderBrush" Value="{StaticResource Se2ControlEdge}" />
      <Setter Property="Foreground" Value="{StaticResource Se2Ink}" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#0B1E2B" />
      <Setter Property="BorderBrush" Value="{StaticResource Se2ControlEdge}" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource Se2Amber}" />
      <Setter Property="Background" Value="#0B1E2B" />
      <Setter Property="MinHeight" Value="8" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Se2Ink}" />
      <Setter Property="FontSize" Value="15" />
    </Style>
  </Application.Styles>
</Application>
